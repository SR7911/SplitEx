<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="18dp" android:paddingVertical="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="My Expenses" android:textSize="11sp" />
      <TextView android:id="@+id/widget_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SplitEx" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:layout_marginEnd="16dp">
        <TextView android:id="@+id/widget_balance_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Remaining balance" android:textSize="10sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="3dp" android:text="—" android:textSize="32sp" android:textStyle="bold" android:includeFontPadding="false" android:gravity="center_vertical" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="34sp" />
      </LinearLayout>
      <TextView android:id="@+id/widget_add" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="23sp" android:gravity="center" android:includeFontPadding="false" android:contentDescription="Add expense" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:layout_marginBottom="10dp">
      <LinearLayout android:id="@+id/widget_details" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_income_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="16dp">
          <TextView android:id="@+id/widget_income_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="↓ Income" android:contentDescription="Income" android:textSize="9sp" />
          <TextView android:id="@+id/widget_income" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="3dp" android:text="—" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_spent_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="14dp">
          <TextView android:id="@+id/widget_spent_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="↑ Spent" android:contentDescription="Expenses" android:textSize="9sp" />
          <TextView android:id="@+id/widget_spent" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="3dp" android:text="—" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:progress="0" />
    <TextView android:id="@+id/widget_budget" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Open SplitEx to load expenses" android:textSize="9sp" android:maxLines="1" />
  </LinearLayout>
  <ImageView android:id="@+id/widget_rendered" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
</FrameLayout>