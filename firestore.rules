rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Developer function - full project access
    function isDeveloper() {
      return request.auth != null && (
        request.auth.token.email == 'sudharsan7911@gmail.com' ||
        request.auth.token.email == 'sudharsansr7911@gmail.com' ||
        request.auth.token.email == 'developersr7911@gmail.com'
      );
    }

    // Users collection - only owner can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || roomAdminUnlink(userId);

      function roomAdminUnlink(userId) {
        let before = resource.data.get('rooms', []);
        let after = request.resource.data.get('rooms', []);
        let removed = before.removeAll(after);
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rooms'])
          && after.toSet().difference(before.toSet()).size() == 0 && removed.size() == 1
          && get(/databases/$(database)/documents/rooms/$(removed[0])).data.adminId == request.auth.uid
          && userId in get(/databases/$(database)/documents/rooms/$(removed[0])).data.memberIds
          && !(userId in getAfter(/databases/$(database)/documents/rooms/$(removed[0])).data.memberIds);
      }
      allow delete: if isDeveloper();

      // Personal transactions - owner only
      match /personal_transactions/{txnId} {
        allow read, create, update, delete: if request.auth.uid == userId || isDeveloper();
      }

      // Import receipts retain deduplication after a user edits/deletes an expense.
      match /bank_sms_receipts/{receiptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /personal_accounts/{accountId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /personal_transfers/{transferId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /merchant_category_rules/{ruleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /personal_savings_goals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /entries/{entryId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Personal budgets - owner only
      match /personal_budgets/{budgetId} {
        allow read, create, update, delete: if request.auth.uid == userId || isDeveloper();
      }

      // Personal recurring - owner only
      match /personal_recurring/{recurringId} {
        allow read, create, update, delete: if request.auth.uid == userId || isDeveloper();
      }

      // Loans & EMI - owner only
      match /loans/{loanId} {
        allow read, create, update, delete: if request.auth.uid == userId || isDeveloper();

        match /payments/{paymentId} {
          allow read, create, update, delete: if request.auth.uid == userId || isDeveloper();
        }
      }

      // Projects - owner only
      match /projects/{projectId} {
        allow read, create, update, delete: if request.auth.uid == userId || isDeveloper();

        match /expenses/{expenseId} {
          allow read, create, update, delete: if request.auth.uid == userId || isDeveloper();
        }
      }
    }

    // Allow anyone to read app version config (needed before auth)
    match /config/app_version {
      allow read: if true;
    }

    // Groups collection
    match /groups/{groupId} {
      allow list: if request.auth != null;
      allow get: if request.auth != null &&
        (request.auth.uid in resource.data.memberIds || isDeveloper());
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid in resource.data.memberIds ||
         (request.auth.uid in request.resource.data.memberIds &&
          !(request.auth.uid in resource.data.memberIds)));
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.createdBy || isDeveloper();

      match /expenses/{expenseId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds || isDeveloper();
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update: if request.auth != null &&
          (request.auth.uid == resource.data.paidBy ||
           request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy);
        allow delete: if request.auth != null &&
          (request.auth.uid == resource.data.paidBy ||
           request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy) || isDeveloper();
      }
    }

    // Active membership controls entries; durable participants retain history.
    match /rooms/{roomId} {
      function participants(data) {
        return data.get('participantIds', []).toSet().union(data.memberIds.toSet());
      }
      function beforeRoom() {
        return get(/databases/$(database)/documents/rooms/$(roomId)).data;
      }
      function afterRoom() {
        return getAfter(/databases/$(database)/documents/rooms/$(roomId)).data;
      }
      function readable() {
        return request.auth != null && request.auth.uid in participants(beforeRoom());
      }
      function openRoom() {
        return !beforeRoom().get('isArchived', false) && !beforeRoom().get('isLocked', false);
      }
      function writer() {
        return readable() && openRoom() && request.auth.uid in beforeRoom().memberIds;
      }
      function versionAdvanced() {
        return afterRoom().get('ledgerVersion', 0) == beforeRoom().get('ledgerVersion', 0) + 1;
      }
      function amountValid(data) {
        return data.amount is number && data.amount > 0 && data.amount < 1000000000;
      }
      function splitValid(data, allowed) {
        return data.splitAmong is list && data.splitAmong.size() > 0
          && data.splitAmong.size() == data.splitAmong.toSet().size()
          && data.splitAmong.toSet().difference(allowed).size() == 0;
      }
      function stableHistory() {
        return request.resource.data.participantIds.toSet() == participants(resource.data)
            .union(request.resource.data.memberIds.toSet());
      }
      function stableLegacyBills() {
        return request.resource.data.legacyBillMemberIds == resource.data.get('legacyBillMemberIds', resource.data.memberIds);
      }
      function joining() {
        return !resource.data.get('isArchived', false) && !resource.data.get('isLocked', false)
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'participantIds', 'ledgerVersion'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 10 && stableHistory();
      }
      function leaving() {
        let removed = resource.data.memberIds.removeAll(request.resource.data.memberIds);
        return request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'participantIds', 'legacyBillMemberIds', 'ledgerVersion', 'isArchived', 'archivedAt', 'archivedBy'])
          && removed.size() == 1
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0
          && (removed[0] == request.auth.uid || request.auth.uid == resource.data.adminId)
          && (removed[0] != resource.data.adminId || request.resource.data.memberIds.size() == 0)
          && (request.resource.data.memberIds.size() == 0
              ? request.resource.data.isArchived == true && request.resource.data.archivedBy == request.auth.uid && request.resource.data.archivedAt == request.time
              : request.resource.data.get('isArchived', false) == resource.data.get('isArchived', false)
                && request.resource.data.get('archivedAt', null) == resource.data.get('archivedAt', null)
                && request.resource.data.get('archivedBy', null) == resource.data.get('archivedBy', null))
          && stableHistory() && stableLegacyBills();
      }
      function transferring() {
        return request.auth.uid == resource.data.adminId && request.auth.uid in resource.data.memberIds
          && !resource.data.get('isArchived', false) && request.resource.data.adminId in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminId', 'ledgerVersion']);
      }
      function archiving() {
        return request.auth.uid == resource.data.adminId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isArchived', 'archivedAt', 'archivedBy', 'participantIds', 'memberIds', 'ledgerVersion'])
          && (request.auth.uid in resource.data.memberIds ||
              (resource.data.memberIds.size() == 0 && resource.data.get('isArchived', false) && !request.resource.data.isArchived))
          && (request.resource.data.memberIds == resource.data.memberIds ||
              (resource.data.memberIds.size() == 0 && !request.resource.data.isArchived && request.resource.data.memberIds == [request.auth.uid]))
          && (request.resource.data.isArchived
              ? request.resource.data.archivedAt == request.time && request.resource.data.archivedBy == request.auth.uid
              : request.resource.data.archivedAt == null && request.resource.data.archivedBy == null)
          && stableHistory();
      }
      function ledgerTouch() {
        return request.auth.uid in participants(resource.data)
          && !resource.data.get('isArchived', false) && !resource.data.get('isLocked', false)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ledgerVersion']);
      }
      function restoringHistory() {
        return request.auth.uid == resource.data.adminId
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'ledgerVersion'])
          && request.resource.data.participantIds.toSet().hasAll(participants(resource.data));
      }
      // Authenticated lookup supports invite codes and legacy room discovery.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.adminId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.participantIds == [request.auth.uid] && request.resource.data.isArchived == false;
      allow update: if request.auth != null
        && request.resource.data.get('ledgerVersion', 0) == resource.data.get('ledgerVersion', 0) + 1
        && (joining() || leaving() || transferring() || archiving() || ledgerTouch() || restoringHistory());
      allow delete: if false;

      match /expenses/{expenseId} {
        allow read: if readable() || isDeveloper();
        allow create: if writer() && versionAdvanced() && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.paidBy in beforeRoom().memberIds && amountValid(request.resource.data)
          && splitValid(request.resource.data, beforeRoom().memberIds.toSet());
        allow update: if writer() && versionAdvanced()
          && (request.auth.uid == resource.data.createdBy || request.auth.uid == beforeRoom().adminId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['title', 'amount', 'category', 'date', 'splitType', 'splitAmong', 'month', 'updatedAt'])
          && amountValid(request.resource.data)
          && splitValid(request.resource.data, beforeRoom().memberIds.toSet().union(resource.data.splitAmong.toSet()));
        allow delete: if writer() && versionAdvanced()
          && (request.auth.uid == resource.data.createdBy || request.auth.uid == beforeRoom().adminId);
      }
      match /bills/{billId} {
        allow read: if readable() || isDeveloper();
        allow create: if writer() && versionAdvanced() && request.resource.data.paidBy == request.auth.uid
          && amountValid(request.resource.data) && splitValid(request.resource.data, beforeRoom().memberIds.toSet());
        allow update: if writer() && versionAdvanced()
          && (request.auth.uid == resource.data.paidBy || request.auth.uid == beforeRoom().adminId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'amount', 'date', 'month'])
          && amountValid(request.resource.data);
        allow delete: if writer() && versionAdvanced()
          && (request.auth.uid == resource.data.paidBy || request.auth.uid == beforeRoom().adminId);
      }
      match /settlements/{settlementId} {
        allow read: if readable() || isDeveloper();
        allow create: if readable() && openRoom() && versionAdvanced()
          && request.resource.data.fromUserId == request.auth.uid && request.resource.data.toUserId in participants(beforeRoom())
          && request.resource.data.fromUserId != request.resource.data.toUserId
          && request.resource.data.roomId == roomId && request.resource.data.status == 'pending' && amountValid(request.resource.data);
        allow update: if readable() && openRoom() && versionAdvanced() && resource.data.status == 'pending'
          && ((request.auth.uid == resource.data.toUserId && request.resource.data.status == 'confirmed'
                && request.resource.data.confirmedAt == request.time
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']))
            || (request.auth.uid == resource.data.fromUserId && request.resource.data.status == 'cancelled'
                && request.resource.data.cancelledAt == request.time
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))
            || (request.auth.uid == resource.data.fromUserId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upiRef'])));
        allow delete: if false;
      }
      match /activities/{activityId} {
        allow read: if readable() || isDeveloper();
        allow create: if request.auth != null && request.resource.data.performedBy == request.auth.uid
          && (request.auth.uid in participants(beforeRoom()) || request.auth.uid in participants(afterRoom()));
        allow update, delete: if false;
      }
    }
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isDeveloper() || (request.auth != null &&
        request.auth.uid == resource.data.targetUserId);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.targetUserId;
      allow delete: if isDeveloper();
    }
  }
}
